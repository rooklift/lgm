{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "LGM",
	"version": "1.0.0",
	"identifier": "com.rooklift.lgm",
	"build": {
		"frontendDist": "../src"
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"label": "main",
				"title": "LGM: Bolo Map Editor",
				"width": 1280,
				"height": 860,
				"backgroundColor": "#10131a",
				"dragDropEnabled": true
			}
		],
		"security": {
			"csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self'"
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"resources": [],
		"linux": {
			"deb": {
				"depends": []
			}
		}
	}
}
